APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_BASE_URL=http://localhost:8000
LOG_LEVEL=INFO

POSTGRES_DB=recrunion
POSTGRES_USER=recrunion
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql+psycopg://recrunion:CHANGE_ME@postgres:5432/recrunion

JWT_SECRET=CHANGE_ME_LONG_RANDOM_VALUE
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=60
CANDIDATE_JOIN_TOKEN_MINUTES=180

APPLICATIONS_ROOT=/data/applications
REPORTS_ROOT=/data/reports
MAX_CV_SIZE_MB=10
APPLICATION_EMAIL=jobs@example.com

LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=

EMBEDDING_PROVIDER=sentence_transformer
EMBEDDING_MODEL=
EMBEDDING_DIMENSION=384

VIDEO_PROVIDER=daily
DAILY_API_KEY=
DAILY_DOMAIN=

PUBLISHER_PROVIDER=bluesky
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=

STT_PROVIDER=faster_whisper
WHISPER_MODEL=tiny.en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true

WORKER_POLL_SECONDS=2
WORKER_MAX_ATTEMPTS=3
WORKER_CONCURRENCY=1

MCP_ENABLED=false
MCP_TRANSPORT=stdio
