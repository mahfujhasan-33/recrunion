APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_BASE_URL=http://localhost:8000
LOG_LEVEL=INFO

POSTGRES_DB=recrunion
POSTGRES_USER=recrunion
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql+psycopg://recrunion:CHANGE_ME@postgres:5432/recrunion

JWT_SECRET=CHANGE_ME_LONG_RANDOM_VALUE
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=60
CANDIDATE_JOIN_TOKEN_MINUTES=180
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_TOKEN_TTL_SECONDS=600

APPLICATIONS_ROOT=/data/applications
REPORTS_ROOT=/data/reports
COMPANY_DOCUMENTS_ROOT=/data/company-documents
MAX_CV_SIZE_MB=10
MINIMUM_CV_TEXT_CHARACTERS=100
MAX_COMPANY_DOCUMENT_SIZE_MB=10
APPLICATION_EMAIL=jobs@example.com

LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_SECONDS=30
GEMINI_MAX_RETRIES=1

EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSION=768
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_TIMEOUT_SECONDS=60
POLICY_RETRIEVAL_CANDIDATE_COUNT=20
POLICY_RETRIEVAL_TOP_K=8
POLICY_RETRIEVAL_MIN_SIMILARITY=0.3
SCREENING_RETRIEVAL_TOP_K=4
SCREENING_RETRIEVAL_MIN_SIMILARITY=0.25

PUBLISHER_PROVIDER=bluesky,blogger
BLUESKY_IDENTIFIER=
BLUESKY_APP_PASSWORD=
BLUESKY_SERVICE_URL=https://bsky.social
BLUESKY_TIMEOUT_SECONDS=15

BLOGGER_BLOG_ID=
BLOGGER_CLIENT_ID=
BLOGGER_CLIENT_SECRET=
BLOGGER_REFRESH_TOKEN=
BLOGGER_API_BASE_URL=https://www.googleapis.com/blogger/v3
BLOGGER_TIMEOUT_SECONDS=20

GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_API_BASE_URL=https://gmail.googleapis.com/gmail/v1
GMAIL_TIMEOUT_SECONDS=20

# Outbound interview invitations require a refresh token authorized for:
# https://www.googleapis.com/auth/gmail.send
GMAIL_SEND_CLIENT_ID=
GMAIL_SEND_CLIENT_SECRET=
GMAIL_SEND_REFRESH_TOKEN=
GMAIL_SEND_SENDER=
GMAIL_SEND_API_BASE_URL=https://gmail.googleapis.com/gmail/v1
GMAIL_SEND_TIMEOUT_SECONDS=20

DRIVE_CLIENT_ID=
DRIVE_CLIENT_SECRET=
DRIVE_REFRESH_TOKEN=
DRIVE_PARENT_FOLDER_ID=root
DRIVE_API_BASE_URL=https://www.googleapis.com/drive/v3
DRIVE_UPLOAD_BASE_URL=https://www.googleapis.com/upload/drive/v3
DRIVE_TIMEOUT_SECONDS=30

EMAIL_AUTO_SYNC_ENABLED=false
EMAIL_SYNC_INTERVAL_SECONDS=300

STT_PROVIDER=faster_whisper
WHISPER_MODEL=tiny.en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true

WORKER_POLL_SECONDS=2
WORKER_MAX_ATTEMPTS=3
WORKER_CONCURRENCY=1

MCP_ENABLED=false
MCP_TRANSPORT=stdio
